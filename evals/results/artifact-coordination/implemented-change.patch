+import json
+
+from money import normalize
+
+TITLE = "Export"
@@ -5,0 +10,12 @@ def heading():
+
+
+def format_receipt(amount):
+    record = normalize(amount)
+    minor = record["minor"]
+    sign = "-" if minor < 0 else ""
+    whole, fraction = divmod(abs(minor), 100)
+    return f"Receipt: {sign}{whole}.{fraction:02d} {record['currency']}"
+
+
+def format_export(record):
+    return json.dumps(record, sort_keys=True)
