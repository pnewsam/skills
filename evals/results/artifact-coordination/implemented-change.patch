+import unittest
+from unittest.mock import patch
+from output import format_receipt
+
+class ReceiptTests(unittest.TestCase):
+    def test_receipt(self):
+        self.assertEqual(format_receipt("12.34"), "Receipt: 12.34 USD")
+
+    def test_half_cent_rounds_up(self):
+        self.assertEqual(format_receipt("1.005"), "Receipt: 1.01 USD")
+
+    def test_negative_fraction(self):
+        self.assertEqual(format_receipt("-0.005"), "Receipt: -0.01 USD")
+
+    def test_receipt_prefix_is_independent_of_generic_heading(self):
+        with patch("output.TITLE", "Export"):
+            self.assertEqual(format_receipt("12.34"), "Receipt: 12.34 USD")
