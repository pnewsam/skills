@@ -0,0 +1,17 @@
+import json
+import unittest
+
+from money import normalize
+from output import format_export, format_receipt
+
+
+class ReportingTests(unittest.TestCase):
+    def test_real_normalization_agrees_across_consumers(self):
+        for amount, minor, display in [("12.34", 1234, "12.34"), ("1.005", 101, "1.01")]:
+            with self.subTest(amount=amount):
+                record = normalize(amount)
+                self.assertEqual(record, {"minor": minor, "currency": "USD"})
+                exported = json.loads(format_export(record))
+                self.assertEqual(exported, record)
+                self.assertEqual(set(exported), {"minor", "currency"})
+                self.assertEqual(format_receipt(amount), f"Receipt: {display} {exported['currency']}")
